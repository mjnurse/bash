#!/usr/bin/env bash

# for f in c_*/*_notes.md; do awk -v dt="$(date -d '1 month ago' +%y-%m-%d)" 'NR==1 || ($1 ~ /[0-9]{2}-[0-9]{2}-[0-9]{2}/ && $1 > dt) {print FNR, $0 "\n"}' $f; done

help_line="Adds a note to a client's clientname_notes.md file"

# Terminal Colours
cdef="\x1b[39m" # default colour
cbla="\x1b[30m"; cgra="\x1b[90m"; clgra="\x1b[37m"; cwhi="\x1b[97m"
cred="\x1b[31m"; cgre="\x1b[32m"; cyel="\x1b[33m"; cblu="\x1b[34m"; cmag="\x1b[35m"; ccya="\x1b[36m";
clred="\x1b[91m"; clgre="\x1b[92m"; clyel="\x1b[93m"; clblu="\x1b[94m"; clmag="\x1b[95m"; clcya="\x1b[96m"

cd "$DOCS"

mode=add
while [[ $# -gt 0 ]]; do
    case "$1" in
        -e|--edit)
            mode=edit
            ;;
        -h|--help)
            echo "Usage:   pn [options] [<client> [<note>]]"
            echo "Options:"
            echo "  -e, --edit    Edit the client's notes file"
            echo "  -l, --list    List the first 30 lines of the client's notes file"
            echo "  -h, --help    Show this help message"
            echo "Example: pn client_name 'This is a note.'"
            exit
            ;;
        -l|--list)
            mode=list
            ;;
        -r|--recent)
            if [[ "$2" != "" ]]; then
                filter="*$2*"
            fi
            for c in c_*$filter; do
                if [[ "$c" == "c_archive"* ]]; then
                    continue
                fi
                f="$c/${c#c_}_notes.md"
                if [[ -f "$f" ]]; then
                    awk -v dt="$(date -d '1 month ago' +%y-%m-%d)" \
                        'NR==1 {print "\n--------------------------------------------------\n" $0, "('$c')"} 
                        ($1 ~ /[0-9]{2}-[0-9]{2}-[0-9]{2}/ && $1 > dt) {print "\n" $0}' $f | mdc
                fi
            done
            exit
            ;;
        *)
            break
            ;;
    esac
    shift
done


if [[ $# -gt 0 ]]; then
    client="${1,,}"
    match=false
    for c in $(ls -d c_*/ q_portfolio/*notes.md | sed 's/^c_//; s/\/$//; s/_notes.md//'); do
        if [[ "$c" == *"$client"* ]]; then
            client="$c"
            match=true
            echo -e "${clmag}Matched: ${cdef}$client\n"
            break
        fi
    done
    if [[ "$match" == false ]]; then
        echo -e "${cred}No matching client found for client:${cdef} $client"
        exit
    fi
    shift
else
    COLUMNS=1
    PS3="Choose client: "
    select client in $(ls -d c_*/ q_portfolio/*notes.md | sed 's/^c_//; s/\/$//; s/_notes.md//'); do
        [ -n "$client" ] && break
    done
fi

if [[ "$client" =~ ^q_portfolio/ ]]; then
    portfolio=true
else
    portfolio=false
fi

if [[ $portfolio == true ]]; then
    :
else
    if [[ ! -f  "c_${client}/${client}_notes.md" ]]; then
        echo -e "# ${client^^}\n\n" > "c_${client}/${client}_notes.md"
    fi
fi

if [[ "$mode" == "list" ]]; then
    if [[ $portfolio == true ]]; then
        head -n 30 "${client}_notes.md" | mdc
    else
        head -n 30 "c_${client}/${client}_notes.md" | mdc
    fi
    exit
fi

if [[ "$mode" == "edit" ]]; then
    if [[ $portfolio == true ]]; then
        code "${client}_notes.md"
    else
        code "c_${client}/${client}_notes.md"
    fi
    exit
fi

if [[ $# -lt 1 ]]; then
    printf "${clcya}Notes: ${cdef}"
    read note
    if [[ -z "$note" ]]; then
        exit
    fi
else
    note="$*"
fi

note="$(date +%y-%m-%d): $note"
echo
echo -e "${clmag}Add:${cdef} $note"
if [[ $portfolio == true ]]; then
    target="${client}_notes.md"
else
    target="c_${client}/${client}_notes.md"
fi
printf "${clmag}To:${cdef} $target ${clcya}(yN) ${cdef}" 
read confirm
if [[ "${confirm^^}" == "Y" ]]; then
    sed -i "2a${note}\n" "$target"
fi
