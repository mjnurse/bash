#!/bin/bash
# Print extended ASCII (128-255) and Unicode box-drawing/arrow characters

echo "=== Extended ASCII (CP437) ==="
for i in {128..255}; do
    printf "%3d: " "$i"
    printf "\x$(printf '%02x' "$i")" | iconv -f CP437 -t UTF-8
    printf "\n"
done

echo ""
echo "=== Unicode Box Drawing & Arrows ==="
chars=(
    "─ U+2500"
    "│ U+2502"
    "┌ U+250C"
    "┐ U+2510"
    "└ U+2514"
    "┘ U+2518"
    "├ U+251C"
    "┤ U+2524"
    "┬ U+252C"
    "┴ U+2534"
    "┼ U+253C"
    "═ U+2550"
    "║ U+2551"
    "╔ U+2554"
    "╗ U+2557"
    "╚ U+255A"
    "╝ U+255D"
    "╠ U+2560"
    "╣ U+2563"
    "╦ U+2566"
    "╩ U+2569"
    "╬ U+256C"
    "↔ U+2194"
    "↕ U+2195"
    "← U+2190"
    "→ U+2192"
    "↑ U+2191"
    "↓ U+2193"
    "◄ U+25C4"
    "► U+25BA"
    "▲ U+25B2"
    "▼ U+25BC"
)

for char in "${chars[@]}"; do
    printf "%s\n" "$char"
done
