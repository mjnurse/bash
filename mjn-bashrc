trash() {
    # func: trash: Moves files to $HOME/.trash instead of deleting them
    mkdir -p $HOME/.trash

    if [[ "$1" == "" ]]; then
        echo -e "\x1b[92m20 largest:\x1b[39m"
        ls -alhS $HOME/.trash | grep -v '^\(total\|.*[[:space:]]\.\.\?$\)' | head -20
        echo -e "\x1b[92m20 most recent:\x1b[39m"
        ls -alht $HOME/.trash | grep -v '^\(total\|.*[[:space:]]\.\.\?$\)' | head -20
        echo -e "\x1b[92mSize:\x1b[39m $(du -d0 -h $HOME/.trash 2>/dev/null)"
        echo -e "\x1b[92mOptions:\x1b[39m"
        echo "-f|--force (force delete without confirmation)"
        echo "-i|--interactive (prompt before deleting each file)"
        echo "-p|--purge <filename (or leading characters)> (delete file from trash)"
    fi
    force_yn=n

    # ignore -r
    if [[ "$1" == "-r" ]]; then
        shift
    fi
    
    # Parse -p option
    if [[ "$1" == "-p" || "$1" == "--purge" ]]; then
        shift
        ls -alh "$HOME/.trash/$1"* 2>/dev/null
        [[ $? -ne 0 ]] && { echo "No matching files found in trash for $1*"; return; }
        read -p "Purge these files? [yN] " answer
        [[ "${answer^^}" == "Y" ]] || { echo "Purge cancelled"; return; }
        \rm "$HOME/.trash/$1"*
        return 1
    fi

    # Parse -f option
    if [[ "$1" == "-f" || "$1" == "--force" || "$1" == "-rf" ]]; then
        force_yn=y
        shift
    fi

    # Parse -i option
    if [[ "$1" == "-i" || "$1" == "--interactive" ]]; then
        force_yn=n
        shift
    fi

    for f in "$@"; do
        if [ ! -e "$f" ]; then
            echo "trash: '$f' not found"
            continue
        fi

        if [[ $force_yn == n ]]; then
            read -p "trash: Are you sure you want to delete '$f' [yN] " answer
            [[ "${answer^^}" == "Y" ]] || { echo "Skipped '$f'"; continue; }
        fi

        timestamp=$(date +%Y%m%d_%H%M%S)
        base=$(basename "$f")
        dest=$HOME/.trash/"$base.$timestamp"
        mv "$f" "$dest"
        if [[ -d $dest ]]; then
            tar -czf "$dest.tar.gz" "$dest" > /tmp/trash.log 2>&1
            \rm -rf "$dest"
        else
	        gzip "$dest" > /tmp/trash.log 2>&1
        fi
    done
}

