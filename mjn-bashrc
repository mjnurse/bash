# Display Git repository, branch, ahead/behind counts and working-tree status
git_prompt_info() {
    local branch repo status upstream counts ahead behind

    # Return if not inside a Git working tree
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return

    # Get current branch (or short commit hash for detached HEAD)
    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
    if [ -z "$branch" ]; then
        branch=$(git rev-parse --short HEAD 2>/dev/null)
    fi

    # Repository directory name and working-tree status
    repo=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)")
    status=$(git status --porcelain 2>/dev/null)

    printf ' [%s:%s' "$repo" "$branch"

    # Compare local commits with the configured upstream
    upstream=$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)

    if [ -n "$upstream" ]; then
        counts=$(git rev-list --left-right --count HEAD..."$upstream" 2>/dev/null)
        ahead=$(printf '%s' "$counts" | awk '{print $1}')
        behind=$(printf '%s' "$counts" | awk '{print $2}')

        [ "${ahead:-0}" -gt 0 ] 2>/dev/null && printf ' ↑%s' "$ahead"
        [ "${behind:-0}" -gt 0 ] 2>/dev/null && printf ' ↓%s' "$behind"
    fi

    # Mark uncommitted changes, including staged changes
    [ -n "$status" ] && printf ' *'

    printf ']'
}


