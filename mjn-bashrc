f() {
    # func: f: Search for a file with case-insensitive name
    if [[ "$1" == "" ]]; then
        echo "Usage: f <filename> - Search for a file with case-insensitive name"
        return 1
    fi
    args=()
    for f in "$@"; do
        args+=(-o -iname "$f")
    done
    find -type d -name ".?*" -prune \
      -o -type d -name venv -prune \
      -o -type d -name google-cloud-sdk -prune \
      -o -type d -name pkg -prune \
      "${args[@]}" -print | sort
}

c() {
    # func: c: Launch Claude with model selection
    model=sonnet
    if [[ "$1" == "" ]]; then
        echo "Note - can use: c \"<question for Claude>\""
        echo
        echo "Select model:"
        echo "h - Haiku (fast)"
        echo "s - Sonnet (general)"
        echo "o - Opus (coding)"
        echo
        read -p "> " m
    fi
    if [[ "$1" == "h" || "$1" == "s" || "$1" == "o" ]]; then
        m="$1"
        shift
    fi
    case $m in
        h)  model=haiku ;;
        s)  model=sonnet ;;
        o)  model=opus ;;
        *)  [[ "$m" != "" ]] && echo "Invalid selection: $m"; return ;;
    esac
    question="$*"
    if [[ "$question" == "" ]]; then
        claude --model $model
    else
        claude --model $model --print "$question"
    fi
}

