f() {
    # func: f: Search for a file with case-insensitive name

    sort_op='-k3' # default sort by name
    case "${1:--h}" in
        -h|--help) 
            echo "Usage: f <filename> - Search for a file with case-insensitive name - use quotes for filenames with wildcards"
            echo "Options:"
            echo "  -t, --time, -d, --date    Order by file timestamps"
            return 1 ;;
        -t|--time|-d|--date)
            sort_op=''
            shift
            ;;
    esac
    args=()
    for f in "$@"; do
        args+=(-o -iname "$f")
    done
    find -type d -name ".?*" -prune \
      -o -type d -name venv -prune \
      -o -type d -name google-cloud-sdk -prune \
      -o -type d -name pkg -prune \
      "${args[@]}" -printf "%TY-%Tm-%Td %TH:%TM  %p\n" | sort $sort_op | sed "s/^/${clcya}/; s/  /${cdef}  /"
}

c() {
    # func: c: Launch Claude with model selection
    model=sonnet
    resume=""
    if [[ "$1" == "" ]]; then
        echo "Note - can use: c \"<question for Claude>\""
        echo
        echo "Select model:"
        echo "h - Haiku (fast)"
        echo "s - Sonnet (general)"
        echo "o - Opus (coding)"
        echo
        read -p "> " m
        echo
        read -p "Resume previous a session [yN]? " answer
        [[ "${answer^^}" == "Y" ]] && resume="--resume"
    fi
    if [[ "$1" == "h" || "$1" == "s" || "$1" == "o" ]]; then
        m="$1"
        shift
    fi
    if [[ "${1^^}" == "R" ]]; then
        resume="--resume"
        shift
    fi
    case $m in
        h)  model=claude-haiku-4-5 ;;
        s)  model=claude-sonnet-5-5 ;;
        o)  model=claude-opus-5-5 ;;
        *)  [[ "$m" != "" ]] && echo "Invalid selection: $m"; return ;;
    esac
    question="$*"
    if [[ "$question" == "" ]]; then
        [[ "$resume" == "" ]] && printf "\n${clgre}(remember c <model> r to resume a previous session)${cdef}\n"
        claude --model $model $resume
    else
        claude --model $model --print "$question"
    fi
}

