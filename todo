#!/usr/bin/env python3

import subprocess
import sqlite3
import re
from datetime import datetime, timedelta
import os
import sys
import readline
import argparse
import signal
import atexit

# File: todo-check-and-run.vbs
#
# A file to check for overdue tasks and run the todo script from WSL hidden window (no ugly popup as it checks)
